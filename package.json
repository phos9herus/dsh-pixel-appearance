{
  "name": "dsh-pixel-appearance",
  "version": "1.8.0",
  "type": "module",
  "description": "Pixel, reactive, static, native, and content-guided Retrospective themes for the DSH Web GUI, with animated pixel backgrounds, pointer halos, configurable pixel geometry, canvas materials, and composer and sidebar materials.",
  "license": "MIT",
  "author": "dsh-pixel-appearance contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/phos9herus/dsh-pixel-appearance.git"
  },
  "homepage": "https://github.com/phos9herus/dsh-pixel-appearance#readme",
  "bugs": {
    "url": "https://github.com/phos9herus/dsh-pixel-appearance/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "appearance",
    "theme",
    "pixel-art",
    "retrospective",
    "review",
    "canvas",
    "glassmorphism"
  ],
  "scripts": {
    "build": "node src/build.mjs",
    "check": "node --check client.js && node --check index.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/**/*",
    "src/**/*",
    "vendor/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
